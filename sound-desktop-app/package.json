{
  "name": "sound-desktop-app",
  "productName": "Sound",
  "version": "1.0.0",
  "description": "Reproductor de música de escritorio (Electron + Angular 21) con biblioteca local de alta resolución, sincronización en el flujo de bienvenida y perfiles de usuario. Por Joel Cabrera.",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port=4205",
    "build": "ng build",
    "build:desktop": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:4205 && npm run electron\"",
    "dist:win": "npm run build:desktop && electron-builder --win nsis"
  },
  "author": {
    "name": "Joel Cabrera",
    "url": "https://github.com/joel-david-cabrera-parrales"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joel-david-cabrera-parrales/sound-media-player.git"
  },
  "homepage": "https://github.com/joel-david-cabrera-parrales/sound-media-player#readme",
  "private": false,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "music-metadata": "^11.16.1",
    "postcss": "8.5.28",
    "rxjs": "~7.8.0",
    "tailwindcss": "4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.0",
    "concurrently": "10.0.5",
    "electron": "44.5.1",
    "electron-builder": "^26.18.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "com.joelcabrera.sound",
    "productName": "Sound",
    "asar": true,
    "files": [
      "electron/**/*",
      "dist/sound-desktop-app/browser/**/*",
      "public/sound-logo.ico",
      "package.json"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "win": {
      "icon": "public/sound-installer.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Sound-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/sound-installer.ico",
      "uninstallerIcon": "public/sound-installer.ico",
      "installerHeaderIcon": "public/sound-installer.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sound",
      "uninstallDisplayName": "Sound"
    }
  }
}
